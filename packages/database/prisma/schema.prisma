datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoomStatus {
  ACTIVE
  EXPIRED
  CLOSED
}

enum MeetingStatus {
  ACTIVE
  ENDED
}

enum MessageType {
  TEXT
  SYSTEM
}

model Room {
  id               String      @id @default(uuid())
  code             String      @unique
  name             String?
  creatorTokenHash String
  status           RoomStatus  @default(ACTIVE)
  maxMembers       Int?
  createdAt        DateTime    @default(now())
  expiresAt        DateTime
  closedAt         DateTime?

  members          Member[]
  messages         Message[]
  meetings         Meeting[]

  @@index([code])
  @@index([expiresAt])
  @@index([status])
}

model Member {
  id               String    @id @default(uuid())
  roomId           String
  displayName      String
  sessionTokenHash String
  joinedAt         DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  leftAt           DateTime?
  isCreator        Boolean   @default(false)

  room             Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messages         Message[]
  reactions        Reaction[]
  hostedMeetings   Meeting[]            @relation("MeetingHost")
  meetingParticipations MeetingParticipant[]

  @@index([roomId])
  @@index([sessionTokenHash])
}

model Meeting {
  id             String               @id @default(uuid())
  roomId         String
  status         MeetingStatus        @default(ACTIVE)
  hostMemberId   String
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  room           Room                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hostMember     Member               @relation("MeetingHost", fields: [hostMemberId], references: [id], onDelete: Cascade)
  participants   MeetingParticipant[]

  @@index([roomId, status])
}

model MeetingParticipant {
  id          String    @id @default(uuid())
  meetingId   String
  memberId    String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([memberId])
}

model Message {
  id          String      @id @default(uuid())
  roomId      String
  memberId    String
  content     String
  messageType MessageType @default(TEXT)
  createdAt   DateTime    @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reactions   Reaction[]

  @@index([roomId, createdAt])
  @@index([memberId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@index([memberId])
}
