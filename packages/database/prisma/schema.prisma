datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Room {
  id               String    @id @default(uuid())
  code             String    @unique
  name             String?
  creatorTokenHash String
  status           String    @default("ACTIVE")
  maxMembers       Int?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  closedAt         DateTime?

  members          Member[]
  messages         Message[]

  @@index([code])
  @@index([expiresAt])
  @@index([status])
}

model Member {
  id               String    @id @default(uuid())
  roomId           String
  displayName      String
  sessionTokenHash String
  joinedAt         DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  leftAt           DateTime?
  isCreator        Boolean   @default(false)

  room             Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messages         Message[]
  reactions        Reaction[]

  @@index([roomId])
  @@index([sessionTokenHash])
}

model Message {
  id          String    @id @default(uuid())
  roomId      String
  memberId    String
  content     String
  messageType String    @default("TEXT")
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member      Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reactions   Reaction[]

  @@index([roomId, createdAt])
  @@index([memberId])
}

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@index([memberId])
}
