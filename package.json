{
  "name": "talknow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @talknow/web dev",
    "dev:server": "pnpm --filter @talknow/server dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@talknow/web...",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @talknow/database db:generate",
    "db:migrate": "pnpm --filter @talknow/database db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
