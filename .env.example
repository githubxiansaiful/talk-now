# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Node server
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Database (SQLite file path)
