# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Node server
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talknow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security
SESSION_SECRET=talknow_super_secret_session_key_32chars_long_placeholder

# LiveKit SFU Media Server (Optional - automatic local Web Audio fallback if omitted)
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
