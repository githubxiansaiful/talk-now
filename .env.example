# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Node server
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Database: Local SQLite or Turso Cloud SQLite
DATABASE_URL=file:./talknow.db
# Optional: Set these to use Turso Cloud Database instead of local SQLite file
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Redis (optional - server uses in-memory if omitted)
REDIS_URL=redis://localhost:6379

# Security (generate a random 32+ character string for production)
SESSION_SECRET=
